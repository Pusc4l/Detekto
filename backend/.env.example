# ==============================================================================
# DETEKTO EDGE ENGINE - ENVIRONMENT CONFIGURATION
# Semua opsional; default = mode lokal penuh dengan auto-fallback.
# ==============================================================================

# --- Fase 1: Infrastruktur Dasar ---
REDIS_URL=redis://127.0.0.1:6379/0
SEARXNG_URL=http://127.0.0.1:8080
MEMGRAPH_HOST=127.0.0.1
MEMGRAPH_PORT=7687

# (Opsional) Supabase untuk fitur Hive-Mind Global. Kosongkan untuk mode SQLite lokal.
SUPABASE_URL=
SUPABASE_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# --- Fase 2: Otak AI (WAJIB DIISI) ---
# 1. MASUKIN API KEY GROQ LU DI SINI (Dapatkan di console.groq.com):
GROQ_API_KEY=your_api_key_here

GROQ_MODEL=openai/gpt-oss-120b

# (Opsional) Fallback Lokal via Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Fase 3: OCR & Ekstraksi ---
# 2. PATH TESSERACT (Sesuaikan dengan lokasi instalasi di Windows lu)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# 3. Bahasa OCR (ind+eng direkomendasikan untuk komentar lokal)
OCR_LANG=ind+eng
RESULT_TTL_SECONDS=900

# --- Fase 4: The Swarm (Scraper Agent) ---
# 4. Celery Worker
CELERY_ENABLED=true

# Batas memori browser (Turunkan ke 1 atau 2 jika RAM < 16GB)
SWARM_MAX_BROWSER_CONCURRENCY=3
SCRAPE_HEADLESS=true
REVERSE_IMAGE_THRESHOLD=0.55